# Kopieer naar .env en vul in.

# Lokaal: start eerst `npm run db`. Op Railway wordt dit automatisch gezet door de Postgres-plugin.
DATABASE_URL="postgresql://rekenen:rekenen@localhost:5440/rekenen"

# Pincode voor het ouderscherm (uitbetalen, overzicht, AI-advies)
PARENT_PIN="1234"

# Optioneel: pincode om de app zelf te openen (leeg = geen pincode)
APP_PIN=""

# Lange willekeurige tekst, zodat inloggen een herstart overleeft
SESSION_SECRET="verander-dit-in-iets-lang-en-willekeurigs"

# AI-leraar (Meester Max) via OpenAI. Zonder sleutel werkt alles, maar zonder AI-leraar.
OPENAI_API_KEY=""
# Optioneel: model(len) in volgorde van voorkeur; standaard kiest de app zelf (gpt-6-luna, gpt-5.5, ...)
# OPENAI_MODEL="gpt-6-luna,gpt-5.5"
# OPENAI_EFFORT="low"
# TEACHER_NAME="Meester Max"
# Reserve: Claude in plaats van OpenAI
# ANTHROPIC_API_KEY=""
# Max. aantal AI-vragen per dag (kostenbewaking)
AI_DAILY_LIMIT=400

# Weekbonus in centen als alle 5 dagtaken van een week af zijn (0 = uit)
WEEK_BONUS=25
